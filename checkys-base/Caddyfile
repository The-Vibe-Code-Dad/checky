{
  auto_https off
  servers {
    trusted_proxies static {$TRUSTED_PROXY_CIDRS:127.0.0.1/32 ::1/128}
    trusted_proxies_strict
    client_ip_headers X-Forwarded-For
  }
}

# The legacy client refuses redirects and only installs bytes matching its signed manifest.
# A bundled installer is served locally. Other images relay only the pinned release file.
(release_request) {
  method GET
  header_up -*
  header_up User-Agent Checky-Desktop-Update
  transport http {
    response_header_timeout 15s
  }
}

(desktop_release) {
  @fetchInstaller {
    method GET HEAD
    path /desktop-updates/{args[2]}
    not file {path}
  }
  handle @fetchInstaller {
    header Content-Disposition attachment
    header Content-Type application/octet-stream
    header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
    rewrite * /{args[0]}/releases/download/{args[1]}/{args[2]}?
    reverse_proxy https://github.com {
      import release_request
      @redirect status 302
      handle_response @redirect {
        @asset vars_regexp asset {rp.header.Location} ^https://release-assets[.]githubusercontent[.]com(/github-production-release-asset/[^#]+)$
        handle @asset {
          rewrite * {re.asset.1}
          reverse_proxy https://release-assets.githubusercontent.com {
            import release_request
            header_down -*
            @failure status 3xx 4xx 5xx
            handle_response @failure {
              respond 502
            }
          }
        }
        respond 502
      }
      handle_response {
        respond 502
      }
    }
  }
}

:80 {
  encode gzip zstd

  route {
    @pocketbase path /api /api/*
    handle @pocketbase {
      reverse_proxy pocketbase:8080 {
        header_up X-Checky-Client-IP {client_ip}
      }
    }

    @pocketbaseAdmin path /_/ /_/*
    handle @pocketbaseAdmin {
      respond "Not Found" 404
    }

    handle {
      @appEntry path / /index.html /baby /baby/ /baby/index.html /service-worker.js /version.json /addons.json
      header @appEntry Cache-Control "no-cache"

      @desktopUpdateManifest path /desktop-updates/latest.json
      header @desktopUpdateManifest Cache-Control "no-store, max-age=0"

      @desktopUpdateFile path /desktop-updates/*.exe /desktop-updates/*.msi
      header @desktopUpdateFile Content-Disposition "attachment"

      header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
      }
      @mainPages not path /baby/ /baby/*
      header @mainPages {
        X-Frame-Options "DENY"
        Content-Security-Policy "frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
      }
      # Only the installed add-on may be embedded inside the same Checky origin.
      @embeddedAddon path /baby/ /baby/*
      header @embeddedAddon {
        X-Frame-Options "SAMEORIGIN"
        Content-Security-Policy "frame-ancestors 'self'; object-src 'none'; base-uri 'self'"
      }
      root * /srv
      route {
        import /etc/caddy/desktop-feed*.caddy
        file_server
      }
    }
  }
}
